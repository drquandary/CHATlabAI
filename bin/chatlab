#!/usr/bin/env bash
# chatlab — launch CHATLabAI (pi pinned to parcc/zai-org/GLM-5.2-FP8).
#
# Usage:
#   chatlab                         # interactive, starts in the CHATLabAI workspace
#   chatlab ./projects/my-paper     # interactive, starts in <dir> (skills + persona still load)
#   chatlab -p "review this"        # one-shot, non-interactive
#   chatlab --help                  # pi help
#
# Any args pi understands are passed through. A leading bare path argument is
# treated as the working directory to start in (handy for per-manuscript work).
#
# Skills + persona load EXPLICITLY via --skill / --append-system-prompt, so
# CHATLabAI behaves identically no matter where you launch it from (no reliance
# on pi's project-trust step for skill discovery).
#
# Auto-update: on launch we run `pi update --all` so users never see the
# "Update Available" banner and stay current. Set CHATLAB_NO_UPDATE=1 to skip
# (e.g. offline, CI, or a pinned install). The update is best-effort: if it
# fails or pi isn't found on PATH, we launch anyway.
set -euo pipefail

# Resolve the workspace root. Follow the symlink (if chatlab is launched via the
# ~/.local/bin/chatlab symlink) so the path points at the real bin/ in the workspace.
SELF="${BASH_SOURCE[0]:-$0}"
while [[ -L "$SELF" ]]; do
  DIR="$(cd "$(dirname "$SELF")" && pwd)"
  SELF="$(readlink "$SELF")"
  [[ "$SELF" != /* ]] && SELF="$DIR/$SELF"
done
SCRIPT_DIR="$(cd "$(dirname "$SELF")" && pwd)"
WORKSPACE_ROOT="$(cd "$SCRIPT_DIR/.." && pwd)"

# Default working directory is the workspace itself.
WORK_DIR="$WORKSPACE_ROOT"

# If the first arg is an existing directory (and not a flag), start there instead.
if [[ $# -gt 0 && "$1" != -* ]]; then
  if [[ -d "$1" ]]; then
    WORK_DIR="$(cd "$1" && pwd)"
    shift
  fi
fi

cd "$WORK_DIR"

# Branded "PARCC is booting" splash while pi self-updates and connects to the
# backend (a few silent seconds otherwise). Cosmetic + best-effort: if the
# helper is missing or errors, launch proceeds unchanged. Skipped for
# non-interactive one-shots (-p / --print) where a splash would be noise.
_show_bootscreen=1
for _a in "$@"; do
  case "$_a" in -p | --print | --json | --rpc) _show_bootscreen=0 ;; esac
done
if [[ "$_show_bootscreen" == "1" && -f "$WORKSPACE_ROOT/packaging/chatlab-bootscreen.sh" ]]; then
  # shellcheck disable=SC1091
  . "$WORKSPACE_ROOT/packaging/chatlab-bootscreen.sh"
  chatlab_bootscreen "PARCC is booting…" \
    "Connecting to litellm.parcc.upenn.edu — needs UPenn network / VPN." 2>/dev/null || true
fi

# Best-effort auto-update before launch. `pi update --all` keeps both pi and
# installed extensions current, hiding the "Update Available" startup banner.
# Skipped when CHATLAB_NO_UPDATE=1, or if pi isn't on PATH (e.g. a broken
# install) — in either case we fall through and launch with whatever pi we
# have. Output is suppressed so a returning user sees only the CHATLabAI
# greeting; failures here must never block the assistant from starting.
if [[ "${CHATLAB_NO_UPDATE:-0}" != "1" ]] && command -v pi >/dev/null 2>&1; then
  pi update --all >/dev/null 2>&1 || true
fi

# Pin provider/model + trust the workspace (loads .pi/settings.json).
# --no-skills disables GLOBAL skill discovery so only CHATLabAI's skills load
# (cleaner, self-contained), then we add each CHATLabAI skill explicitly below.
ARGS=(--provider parcc --model zai-org/GLM-5.2-FP8 --approve --no-skills)

# Explicitly load CHATLabAI's skills so discovery doesn't depend on cwd/trust.
# Passing the parent .pi/skills directory loads all 10 skills at once.
ARGS+=(--skill "$WORKSPACE_ROOT/.pi/skills")

# Append the AGENTS.md persona so the CHATLabAI framing is always in context.
ARGS+=(--append-system-prompt "$WORKSPACE_ROOT/AGENTS.md")

# Explicitly load the CHATLabAI welcome extension (custom startup greeting) by
# absolute path, so it renders no matter which directory you launch in. Its
# setHeader() replaces pi's built-in startup banner with the CHATLabAI greeting.
# (Like --skill above, this avoids depending on pi discovering .pi/ in the cwd —
# essential because you often launch pointed at a manuscript folder.)
if [[ -f "$WORKSPACE_ROOT/.pi/extensions/welcome.ts" ]]; then
  ARGS+=(--extension "$WORKSPACE_ROOT/.pi/extensions/welcome.ts")
fi

exec pi "${ARGS[@]}" "$@"
